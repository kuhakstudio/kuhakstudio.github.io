---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TracingBeam from '../../components/ui/TracingBeam';
import policy from '../../data/privacy-main.html?raw';
---
<SiteLayout title="Privacy Policy · Shakchunnir Badhon · KUHAK Studio" description="Privacy policy of the game Shakchunnir Badhon by Kuhak Studio." canonicalPath="/shakchunnir-badhon/privacy.html">
<div class="relative isolate bg-(--b-teal)/72">
<div class="relative mx-auto max-w-4xl md:pl-12">
<TracingBeam client:visible className="top-16 hidden md:block md:top-24" />
<div id="main" lang="en" class="px-5 py-12 text-(--ink-2) sm:px-8 md:py-20 [&_main]:p-0 [&_.eyebrow]:font-['Cinzel'] [&_.eyebrow]:text-xs [&_.eyebrow]:tracking-[.22em] [&_.eyebrow]:text-(--accent-2) [&_.eyebrow]:uppercase [&_h1]:mt-3 [&_h1]:mb-5 [&_h1]:font-['Cinzel'] [&_h1]:text-4xl [&_h1]:font-semibold [&_h1]:text-(--hi-2) md:[&_h1]:text-5xl [&_h2]:mt-12 [&_h2]:mb-5 [&_h2]:border-b [&_h2]:border-(--line)/10 [&_h2]:pb-4 [&_h2]:font-['Cinzel'] [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-(--hi-2) [&_.bn-doc_h2]:font-sans [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-(--accent) [&_p]:my-4 [&_p]:text-sm [&_p]:leading-8 [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:my-3 [&_li]:text-sm [&_li]:marker:text-(--accent-2) [&_a]:text-(--accent) [&_a]:underline [&_a]:decoration-[#f04f06]/50 [&_a]:underline-offset-4 [&_nav]:flex [&_nav]:gap-5 [&_nav]:py-4 [&_section]:scroll-mt-24 [&_b]:text-(--ink)" set:html={policy}></div>
</div>
</div>
</SiteLayout>
