---
import BrandLogo from './BrandLogo.astro';
import TextHoverEffect from './ui/TextHoverEffect';
---
<footer class="relative isolate overflow-hidden bg-linear-to-b from-(--f-1) to-(--f-2) pt-8 before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-linear-to-r before:from-transparent before:via-[#f04f06]/55 before:to-transparent after:pointer-events-none after:absolute after:top-0 after:left-1/2 after:-z-10 after:h-40 after:w-[60%] after:-translate-x-1/2 after:bg-[radial-gradient(ellipse_at_top,rgba(240,79,6,.12),transparent_70%)]">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle,#fceed212_1px,transparent_1px)] bg-size-[12px_12px] opacity-40 [mask-image:linear-gradient(to_bottom,black,transparent_70%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[1320px] px-5 sm:px-8">
    <div class="mb-6 flex flex-col justify-between gap-3 border-b border-(--line)/10 pb-5 sm:flex-row sm:items-center">
      <div class="w-44 [&_img]:w-full"><BrandLogo size="footer" /></div>
      <p class="max-w-sm font-['Cormorant_Garamond'] text-base leading-6 text-(--lead) italic sm:text-right [[lang=bn]_&]:font-sans [[lang=bn]_&]:text-xs [[lang=bn]_&]:not-italic" data-i18n="moon.footer">Original games. Bengali roots. A world of stories waiting to be played.</p>
    </div>
    <div class="grid grid-cols-2 gap-x-6 gap-y-6 pb-6 md:grid-cols-[1.1fr_1fr_1fr_1.4fr] md:gap-10 [&_h2]:mb-3 [&_h2]:font-['Cinzel'] [&_h2]:text-xs [&_h2]:font-semibold [&_h2]:tracking-[.18em] [&_h2]:text-(--accent-2) [&_h2]:uppercase [[lang=bn]_&_h2]:font-sans [[lang=bn]_&_h2]:tracking-normal [&_nav]:flex [&_nav]:flex-col [&_nav]:items-start [&_nav]:gap-2 [&_nav]:text-xs [&_nav]:leading-6 [&_nav]:text-(--ink-2) [&_nav_a]:transition-colors [&_nav_a:hover]:text-(--accent)">
      <div><h2 data-i18n="Games">Games</h2><nav aria-label="Games"><a href="/shakchunnir-badhon/">Shakchunnir Badhon ↗︎</a><a href="/shakchunnir-badhon/#screens" data-i18n="nav.gallery">Gallery</a><span class="mt-1 inline-flex items-center gap-2 rounded border border-[#f59a3c]/30 bg-[#f59a3c]/[.06] px-2 py-0.5 text-[10px] text-(--accent)"><span aria-hidden="true">●</span><span data-i18n="Coming soon · Android">Coming soon · Android</span></span></nav></div>
      <div><h2 data-i18n="footer.studio">Studio</h2><nav aria-label="Studio"><a href="/#studio" data-i18n="Our story">Our story</a><a href="/#games" data-i18n="footer.our.games">Our games</a><a href="/shakchunnir-badhon/privacy.html" data-i18n="Privacy policy">Privacy policy</a></nav></div>
      <div><h2 data-i18n="footer.community">Community</h2><nav aria-label="Community"><a href="https://www.facebook.com/kuhakstudio" target="_blank" rel="noopener noreferrer">KUHAK Studio ↗︎</a><a href="https://www.facebook.com/shakchunnirbadhon/" target="_blank" rel="noopener noreferrer">Shakchunnir Badhon ↗︎</a><a href="/#contact" data-i18n="Contact">Contact</a></nav></div>
      <div><h2 data-i18n="footer.contact.info">Contact info</h2><nav aria-label="Contact"><a href="mailto:kuhakstudio@gmail.com" class="inline-flex max-w-full items-center gap-1.5 break-all max-[359px]:text-[10px] min-[360px]:gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 shrink-0 text-(--accent)" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>kuhakstudio@gmail.com</a><span data-i18n="Made in Bangladesh">Made in Bangladesh</span><a href="/#contact" class="text-(--accent)" data-i18n="footer.say.hello">Say hello ↗︎</a></nav></div>
    </div>
    <div class="flex flex-col justify-between gap-2 border-t border-(--line)/10 py-4 text-[10px] text-(--ink-3) sm:flex-row"><span>© 2026 KUHAK Studio. <span data-i18n="footer.rights">All rights reserved.</span></span><span class="font-['Cormorant_Garamond'] text-sm text-(--s-ink) italic [[lang=bn]_&]:font-sans [[lang=bn]_&]:not-italic" data-i18n="bold.slogan">Where the Legends of Bengal Come Alive</span></div>
  </div>
  <div class="relative px-3 pt-2 pb-4 sm:px-6"><div class="mx-auto w-full max-w-[1500px]"><TextHoverEffect client:visible text="KUHAK STUDIO" /></div></div>
</footer>
