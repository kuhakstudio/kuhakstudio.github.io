---
import GlowingEffect from './ui/GlowingEffect';
import BorderGlow from './ui/BorderGlow';
import Meteors from './ui/Meteors';
import { eyebrow, h2, ivory, ember, body, muted, card, rule, band } from '../lib/theme';
---
<section id="games" class={`games-section relative isolate py-16 md:py-24 ${band.teal} ${rule}`}>
  <div class="wrap mx-auto w-full max-w-[1320px] px-5 sm:px-8">
    <div class="section-heading mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div><p class={eyebrow} data-i18n="01 / Our games">01 / Our games</p><h2 class={h2}><span class={ivory} data-i18n="copy.legends">Old Legends. New Worlds.</span><br><span data-i18n="copy.adventure" class={ember}>Your Adventure.</span></h2></div>
      <p class={`section-aside max-w-72 ${body} ${muted}`} data-i18n="Our first story is almost ready.&lt;br&gt;And there are more on the horizon.">Our first story is almost ready.<br>And there are more on the horizon.</p>
    </div>
    <article class={`game-showcase relative ${card}`}>
      <GlowingEffect client:visible />
      <a class="showcase-art group relative block aspect-[2/1] overflow-hidden rounded-t-2xl bg-(--night) [&>img]:size-full [&>img]:object-cover [&>img]:object-[60%_40%] [&>img]:transition-transform [&>img]:duration-700 motion-safe:[&:hover>img]:scale-105" href="/shakchunnir-badhon/" aria-label="Discover Shakchunnir Badhon"><img decoding="async" src="/img/shakchunnir-badhon-hero.webp" alt="Promotional artwork: Kalu and Shakchunni race past the ghosts of a moonlit Bengal village" width="1774" height="887" loading="lazy" /><span class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-(--card) to-transparent" aria-hidden="true"></span><span class="art-label absolute top-5 left-5 bg-linear-to-r from-[#e2560f] to-[#f59a3c] px-3 py-1.5 text-[9px] font-extrabold tracking-wider text-[#1a0a03] uppercase" data-i18n="The first KUHAK original">The first KUHAK original</span><span class="absolute bottom-5 left-5 rounded bg-[#05090b]/70 px-2 py-1 text-[9px] text-[#d6d0c2]" data-i18n="art.promo">Promotional artwork</span><span class="art-arrow absolute right-6 bottom-6 rounded-full border border-(--line)/20 bg-black/60 px-3 py-1 text-4xl text-(--accent)" aria-hidden="true">↗︎</span></a>
      <div class="showcase-copy grid gap-7 rounded-b-2xl p-6 md:grid-cols-[1fr_1.1fr] md:gap-14 md:p-9">
        <div class="showcase-heading border-b border-(--line)/10 pb-6 md:border-0 md:pb-0"><p class="status mb-5 flex items-center gap-2 text-[10px] text-(--accent)"><span class="live-dot inline-block size-1.5 shrink-0 rounded-full bg-[#f59a3c] shadow-[0_0_10px_#f59a3c]"></span><span data-i18n="Coming soon · Android">Coming soon · Android</span></p><h3 class={`game-title-bn font-['Atma'] text-[clamp(2rem,3.5vw,3.4rem)] leading-snug tracking-normal ${ivory}`} lang="bn">শাঁকচুন্নির বাঁধন</h3><p class="game-title-en mt-3 font-['Cinzel'] text-sm font-semibold tracking-[.12em] text-(--ink)">Shakchunnir Badhon</p><p class={`game-meta mt-5 text-[9px] tracking-widest ${muted}`} data-i18n="FOLK HORROR / ENDLESS RUNNER">FOLK HORROR / ENDLESS RUNNER</p></div>
        <div class="showcase-description"><p class="game-hook mb-4 font-['Cormorant_Garamond'] text-[1.7rem] leading-tight font-semibold text-(--lead) [[lang=bn]_&]:font-sans [[lang=bn]_&]:text-2xl" data-i18n="She has found her groom.&lt;br&gt;He has other plans.">She has found her groom.<br>He has other plans.</p><p class={body} data-i18n="A lantern. A village after dark. A very persistent ghost. Run into a playful Bengali folk-horror adventure, and keep the light alive.">A lantern. A village after dark. A very persistent ghost. Run into a playful Bengali folk-horror adventure, and keep the light alive.</p><div class="showcase-actions mt-6 flex flex-col items-start gap-5 lg:flex-row lg:items-center"><a class="relative inline-flex rounded-full bg-(--line)/10 p-px" href="/shakchunnir-badhon/"><BorderGlow client:visible /><span class="relative z-10 inline-flex min-h-12 items-center gap-6 rounded-full bg-linear-to-r from-[#1c0c05] to-[#0a0705] px-6 text-xs font-bold text-[#fceed2]"><span data-i18n="Discover the game">Discover the game</span><span class="text-base text-[#f59a3c]" aria-hidden="true">↗︎</span></span></a><a class={`social-subtle text-[10px] leading-5 ${muted} hover:text-(--accent)`} href="https://www.facebook.com/shakchunnirbadhon/" target="_blank" rel="noopener noreferrer"><span data-i18n="Follow the game on Facebook">Follow the game on Facebook</span> ↗︎</a></div></div>
      </div>
    </article>
    <div class="future-note relative mt-5 flex items-center gap-5 overflow-hidden rounded-2xl border border-[#f59a3c]/20 bg-linear-to-r from-(--t-1)/90 via-(--card)/90 to-(--card)/90 px-6 py-8 [&>p]:flex-1 [&>p]:text-xs">
      <Meteors client:visible number={16} />
      <span class="tiny-star relative text-3xl text-(--accent)" aria-hidden="true">✳︎</span><p class="relative"><strong class="font-['Cinzel'] text-sm font-semibold tracking-[.06em] text-(--ink) [[lang=bn]_&]:font-sans" data-i18n="More worlds are taking shape.">More worlds are taking shape.</strong><span class={`mt-1 block text-[12px] leading-6 ${muted}`} data-i18n="New stories. New ways to play. The same Bengali soul.">New stories. New ways to play. The same Bengali soul.</span></p><span class="relative text-2xl text-(--accent)" aria-hidden="true">↗︎</span>
    </div>
  </div>
</section>
