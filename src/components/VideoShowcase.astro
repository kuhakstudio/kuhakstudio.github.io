---
// The game page's trailer and gameplay (YouTube Shorts), as VideoPoster tiles.
import { eyebrow, h2Small, ivory, rule, band, textLink } from '../lib/theme';
import { VIDEOS, YOUTUBE_CHANNEL } from '../lib/videos';
import VideoPoster from './VideoPoster.astro';
---
<section id="watch" class={`relative isolate py-16 md:py-24 ${band.deep} ${rule}`}>
  <div class="wrap mx-auto grid w-full max-w-[1320px] items-center gap-10 px-5 sm:px-8 md:grid-cols-[1fr_minmax(0,520px)] md:gap-16">
    <div>
      <p class={eyebrow} data-i18n="video.eyebrow">Watch</p>
      <h2 data-i18n="video.title" class={`${h2Small} mb-5 ${ivory}`}>See the chase</h2>
      <p class="mb-6 max-w-[520px] text-sm leading-7 text-(--ink-3)" data-i18n="video.text">The trailer, and a minute of real gameplay recorded straight from the game.</p>
      <a class={textLink} href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer"><span data-i18n="video.more">More on YouTube</span> ↗︎</a>
    </div>
    <div class="videos grid grid-cols-2 gap-4 sm:gap-6 [&_figcaption]:mt-3 [&_figcaption]:text-center [&_figcaption]:font-['Cinzel'] [&_figcaption]:text-[10px] [&_figcaption]:tracking-[.12em] [&_figcaption]:text-(--ink-3) [[lang=bn]_&_figcaption]:font-sans [[lang=bn]_&_figcaption]:tracking-normal">
      {VIDEOS.map(video => (
        <figure class="min-w-0">
          <VideoPoster video={video} class="rounded-2xl border border-(--line)/15 shadow-[0_30px_70px_-30px_rgba(0,0,0,.95),0_0_50px_-25px_rgba(240,79,6,.4)]" />
          <figcaption data-i18n={`video.${video.key}`}>{video.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
