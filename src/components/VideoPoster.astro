---
// One YouTube video as a 9:16 poster tile: links to YouTube (the no-JS fallback); site.js opens `.video-open` links
// in a dialog with the privacy-enhanced embed, so nothing loads from YouTube until the visitor taps play.
// The play button sits low, on the road, so it never covers the posters' text.
import type { VIDEOS } from '../lib/videos';
interface Props { video: (typeof VIDEOS)[number]; class?: string; small?: boolean }
const { video, class: extra = '', small = false } = Astro.props;
---
<a class={`video-open group relative block overflow-hidden ${extra}`} href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer" data-video={video.id}>
  <img class="aspect-[9/16] w-full object-cover transition-all duration-500 motion-safe:group-hover:scale-105 group-hover:brightness-110" src={video.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
  <span class="absolute inset-0 bg-linear-to-t from-black/55 via-transparent to-transparent" aria-hidden="true"></span>
  <span class={`absolute top-[80%] left-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-linear-to-br from-[#e2560f] to-[#f59a3c] text-[#1a0a03] shadow-[0_0_30px_-4px_#f04f06] transition-transform duration-300 motion-safe:group-hover:scale-110 ${small ? '' : 'md:size-16'}`} aria-hidden="true"><svg viewBox="0 0 24 24" class={`ml-0.5 size-5 ${small ? '' : 'md:size-7'}`} fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg></span>
  <span class="absolute right-2 bottom-2 rounded bg-black/75 px-1.5 py-0.5 text-[10px] leading-4 font-semibold text-[#efe8da]" aria-hidden="true">{video.time}</span>
  <span class="sr-only" data-i18n={`video.play.${video.key}`}>{video.play}</span>
</a>
