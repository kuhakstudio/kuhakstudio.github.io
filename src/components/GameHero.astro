---
import Spotlight from './ui/Spotlight';
import BorderGlow from './ui/BorderGlow';
import { eyebrow, ivory, lead, body, muted } from '../lib/theme';
---
<header class="relative isolate w-full min-w-0 overflow-hidden border-b border-(--line)/10 bg-(--night) lg:flex lg:h-[clamp(600px,50vw,900px)] lg:items-center">
  <picture class="block lg:absolute lg:inset-0 lg:-z-20">
    <source media="(max-width: 767px)" srcset="/img/shakchunnir-badhon-hero-mobile.webp" />
    <img decoding="async" src="/img/shakchunnir-badhon-hero.webp" alt="Kalu runs with his lantern as Shakchunni and the ghosts of Bengali folklore emerge along a moonlit village path" width="1774" height="887" class="aspect-[2/1] w-full object-cover lg:h-full lg:object-[65%_center]" fetchpriority="high" />
  </picture>
  <div class="pointer-events-none absolute inset-0 -z-10 hidden bg-linear-to-r from-(--night) via-(--night)/60 to-transparent lg:block" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 hidden h-1/3 bg-linear-to-t from-(--night) to-transparent lg:block" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-48 -left-48 -z-10 hidden size-[36rem] rounded-full bg-[radial-gradient(circle,rgba(240,79,6,.28)_0%,rgba(240,79,6,0)_68%)] lg:block" aria-hidden="true"></div>
  <Spotlight client:visible className="hidden lg:block [[data-theme=light]_&]:hidden" />
  <div class="relative mx-auto w-full max-w-[1320px] px-5 pt-8 pb-10 sm:px-8 md:py-16">
    <div class="max-w-2xl lg:max-w-[38%]">
      <p class={eyebrow} data-i18n="moon.game.label">A KUHAK ORIGINAL / COMING SOON</p>
      <h1 class={`font-['Atma'] text-5xl leading-snug lg:text-6xl ${ivory}`} lang="bn">শাঁকচুন্নির বাঁধন<span class="sr-only" lang="en"> | Shakchunnir Badhon</span></h1>
      <p class="mt-3 font-['Cinzel'] text-sm font-semibold tracking-[.18em] text-(--ink-2)">Shakchunnir Badhon</p>
      <p class={`mt-7 text-[1.75rem] leading-snug ${lead}`} data-i18n="She has found her groom.&lt;br&gt;He has other plans.">She has found her groom.<br>He has other plans.</p>
      <p class={`mt-5 ${body}`} data-i18n="moon.game.intro">One lantern. A village after dark. A chase through the ghost stories of Bengal.</p>
      <a href="#screens" class="relative mt-8 inline-flex rounded-full bg-(--line)/10 p-px"><BorderGlow client:visible /><span class="relative z-10 inline-flex min-h-12 items-center gap-6 rounded-full bg-linear-to-r from-[#1c0c05] to-[#0a0705] px-6 text-xs font-bold text-[#fceed2]"><span data-i18n="nav.gallery">Gallery</span><span class="text-base text-[#f59a3c]" aria-hidden="true">↗︎</span></span></a>
      <p class={`mt-6 text-[9px] tracking-wide ${muted}`} data-i18n="game.hero.art">Promotional artwork inspired by the game’s characters.</p>
    </div>
  </div>
</header>
